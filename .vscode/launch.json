{
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Start scheduler",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/scheduler/cmd/main.go",
            "env": {
                "PG_DSN": "postgres://scheduler:scheduler@localhost:5432/scheduler?sslmode=disable",
                "NATS_URL": "nats://localhost:4222",
                "SCHEDULER_INTERVAL": "10s",
                "HTTP_PORT": "8090"
            }
        },
        {
            "name": "Start worker",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/worker/cmd/main.go",
            "env": {
                "NATS_URL": "nats://localhost:4222"
            }
        }
    ]
}